# 基础中间件账号密码配置示例
#
# 使用方式：
#   cp .env.example .env
# 然后修改 .env 中的账号密码，再执行 ./mix docker-services up
#
# 生效范围：
#   ./mix docker-services up 创建的 MySQL、PostgreSQL(含 pgvector)、Redis、
#   ElasticSearch、MongoDB、ClickHouse、RabbitMQ、Neo4j 容器
#
# 注意事项：
#   1. .env 已被 .gitignore 忽略，请勿将真实密码提交到仓库
#   2. 容器已存在时修改本文件不会自动生效，需先执行 ./mix docker-services delete 再 up
#   3. ElasticSearch 的安全认证只在首次启动时写入密码；若数据卷 es-data 是用旧配置
#      （未开启认证）创建的，需先删除该卷再启动
#   4. 密码建议避免空格、单引号、$ 等字符；若必须使用，请用单引号包裹，
#      并确认 dist 部署脚本（scripts/build.sh 按 = 简单切分 .env）解析结果一致
#   5. 修改用户名（POSTGRES_USER / MONGO_USER / CLICKHOUSE_USER / RABBITMQ_USER /
#      NEO4J_USER）后，必须同步修改各服务 .env 中的对应用户名，否则服务无法连接
#   6. 应用侧密码变量名与本文件不完全一致，需在服务目录的 .env 中单独配置

# ===== MySQL =====
# 用户名固定为 root（官方镜像不支持自定义 root 用户名）
MYSQL_ROOT_PASSWORD=123456

# ===== PostgreSQL =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456

# ===== Redis =====
# Redis 无用户名，仅支持设置密码
REDIS_PASSWORD=123456

# ===== ElasticSearch =====
# 版本号同时决定镜像与 IK 分词器插件版本，两者必须一致
ES_VERSION=7.12.1
# IK 分词器为文章搜索刚需：执行 up 时会在 ES 启动前自动下载安装（约 4.5MB，
# 需要服务器可访问 release.infinilabs.com 或 get.infini.cloud），启动后自动验证分词可用
# 如需关闭自动安装，将 ES_IK_ENABLED 置为 false
ES_IK_ENABLED=true
# 离线安装（生产服务器无外网时使用）：把 IK 插件 zip 放到服务器任意路径，填宿主机绝对路径
# ES_IK_OFFLINE=false: 默认在线下载；若同时配置了 ES_IK_OFFLINE_ZIP 且文件存在，则优先使用离线包
# ES_IK_OFFLINE=true : 强制只用离线包，不再尝试在线地址（路径为空或文件不存在时直接报错）
ES_IK_OFFLINE=false
# ES_IK_OFFLINE_ZIP=/opt/packages/elasticsearch-analysis-ik-7.12.1.zip
# 默认开启 X-Pack 安全认证，内置超级用户为 elastic
# 仅开启账号密码认证，未启用 TLS，服务侧连接使用 http（如需加密请另行配置证书或前置 HTTPS）
# 服务侧需配置 DB_ES_USERNAME=elastic 与 DB_ES_PASSWORD（当前仅 GoZero 使用 ES）
# 如镜像启动异常，可临时将 ES_SECURITY_ENABLED 置为 false 关闭认证
ES_SECURITY_ENABLED=true
ES_PASSWORD=123456
# 可选：ES 堆内存大小，开启认证后如出现内存不足可调大（例如 512m）
# ES_HEAP_SIZE=256m

# ===== MongoDB =====
MONGO_USER=root
MONGO_PASSWORD=123456

# ===== ClickHouse =====
CLICKHOUSE_USER=hcsy
CLICKHOUSE_PASSWORD=123456

# ===== RabbitMQ =====
# 管理后台：http://<host>:15672
RABBITMQ_USER=hcsy
RABBITMQ_PASSWORD=123456

# ===== Neo4j =====
# Browser：http://<host>:7474，Bolt：bolt://<host>:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=123456

# ===== 兼容变量（可选） =====
# 旧配置中的公共密码，未单独设置 MYSQL_ROOT_PASSWORD / POSTGRES_PASSWORD 时作为其回退值
# DB_PASSWORD=change_me_db_password
