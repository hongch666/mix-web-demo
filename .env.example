# MySQL 配置
# 用户名固定为 root
MYSQL_ROOT_PASSWORD=123456

# PostgreSQL 配置
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=demo

# Redis 配置
REDIS_PASSWORD=123456

# ElasticSearch 配置
ES_VERSION=7.12.1
ES_IK_ENABLED=true
# ES_IK_OFFLINE_ZIP=/opt/packages/elasticsearch-analysis-ik-7.12.1.zip
ES_IK_OFFLINE=false
ES_SECURITY_ENABLED=true
ES_PASSWORD=123456
# ES_HEAP_SIZE=256m

# MongoDB 配置
MONGO_USER=root
MONGO_PASSWORD=123456

# ClickHouse 配置
CLICKHOUSE_USER=hcsy
CLICKHOUSE_PASSWORD=123456

# RabbitMQ 配置
RABBITMQ_USER=hcsy
RABBITMQ_PASSWORD=123456

# Neo4j 配置
NEO4J_USER=neo4j
NEO4J_PASSWORD=12345678

# 兼容变量
# DB_PASSWORD=change_me_db_password

# 应用镜像配置
# 仓库前缀取值必须以 / 结尾
DOCKER_IMAGE_PREFIX=ghcr.io/hongch666/mix-web-demo/
# DOCKER_IMAGE_TAG=latest

# Apifox 文档同步
# 必填
APIFOX_ACCESS_TOKEN=
APIFOX_PROJECT_ID=

# 可选参数
# APIFOX_BASE_URL=https://api.apifox.com
# APIFOX_API_VERSION=2024-03-28
# APIFOX_LOCALE=zh-CN
# APIFOX_FOLDER_SPRING=
# APIFOX_FOLDER_GOZERO=
# APIFOX_FOLDER_NESTJS=
# APIFOX_FOLDER_FASTAPI=
APIFOX_SCHEMA_FOLDER_SPRING=21995811
APIFOX_SCHEMA_FOLDER_GOZERO=21995809
APIFOX_SCHEMA_FOLDER_NESTJS=21995815
APIFOX_SCHEMA_FOLDER_FASTAPI=21995819
# APIFOX_SCHEMA_FOLDER_ID=
# APIFOX_BRANCH_ID=
# APIFOX_MODULE_ID=
# APIFOX_ENDPOINT_OVERWRITE_BEHAVIOR=AUTO_MERGE
# APIFOX_SCHEMA_OVERWRITE_BEHAVIOR=AUTO_MERGE
# APIFOX_DELETE_UNMATCHED_RESOURCES=true
# APIFOX_VERIFY_SCHEMA_REFS=true
# APIFOX_UPDATE_FOLDER_OF_CHANGED_ENDPOINT=true
# APIFOX_MAINTAINER=
# APIFOX_MAINTAINER_AUTO=true
# APIFOX_MAINTAINER_CLEAN_EXTENSION=true
# APIFOX_MAINTAINER_FORCE=false

# README 同步到 Apifox 文档
# 配置文档 ID 时为原地更新，首次创建用 ./mix apifox-readme --create
APIFOX_README_DOC_ID=
# APIFOX_README_DOC_NAME=
# APIFOX_README_DOC_FOLDER_ID=0
# APIFOX_README_DOC_MODULE_ID=
# APIFOX_README_BRANCH=
# APIFOX_README_FILE=README.md
# APIFOX_CLI_REGISTRY=https://registry.npmmirror.com/
APIFOX_CLI_AUTO_INSTALL=true
