syntax = "v2"

@server (
	group:      task
	tags:       task
	prefix:     /task
	middleware: UserContextMiddleware,RecoveryMiddleware,InternalServiceMiddleware
)
service App {
	@doc (
		summary:     "手动触发同步ES任务"
		description: "手动触发同步MySQL文章数据到ElasticSearch"
	)
	@handler SyncESHandler
	post /syncer (SyncESReq) returns (SyncESResp)
}

type (
	SyncESReq  {
		Resource   string  `json:"resource,optional"`    // 资源名，固定 articles
		ChangeType string  `json:"change_type,optional"` // 变更类型：insert、update、delete
		Ids        []int64 `json:"ids,optional"`         // 受影响文章 ID，为空时退化为全量同步
	}
	SyncESResp  {}
)
