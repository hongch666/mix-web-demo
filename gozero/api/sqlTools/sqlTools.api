syntax = "v2"

@server (
	group:      sqlTools
	tags:       sqlTools
	prefix:     /sql-tools
	middleware: UserContextMiddleware,RecoveryMiddleware,InternalServiceMiddleware
)
service App {
	@doc (
		summary:     "获取表结构信息"
		description: "获取白名单内MySQL表的结构信息，可选指定表名"
	)
	@handler SqlToolsGetTablesHandler
	get /tables (SqlToolsGetTablesReq) returns (SqlToolsGetTablesResp)

	@doc (
		summary:     "执行只读参数化SQL查询"
		description: "执行受限的只读参数化SQL查询，表名白名单控制，强制参数化占位符和LIMIT"
	)
	@handler SqlToolsQueryHandler
	post /query (SqlToolsQueryReq) returns (SqlToolsQueryResp)
}

type (
	SqlToolsGetTablesReq {
		// 长度上限与 constants.SqlToolsMaxTableNameLength 保持一致
		Table string `json:"table,optional" validate:"maxrunes=64"` // 表名，可选；不传则返回白名单内全部表
	}
	SqlToolsTableInfo {
		Table   string               `json:"table"` // 表名
		Columns []SqlToolsColumnInfo `json:"columns,optional"` // 列信息
	}
	SqlToolsColumnInfo {
		Name    string `json:"name"` // 列名
		Type    string `json:"type"` // 列类型
		Key     string `json:"key"` // 键类型，如 PRI
		Comment string `json:"comment"` // 列注释
	}
	SqlToolsGetTablesResp {
		Data []SqlToolsTableInfo `json:"data"` // 表结构列表
	}
	SqlToolsQueryReq {
		// 长度上限与 constants.SqlToolsMaxQueryLength 保持一致
		Query  string            `json:"query" validate:"notblank,maxrunes=8000"` // 只读 SQL，须使用参数占位符
		Params map[string]string `json:"params,optional"` // 占位符参数，key 为参数名
	}
	SqlToolsQueryResult {
		Columns  []string   `json:"columns"` // 结果列名
		Rows     [][]string `json:"rows"` // 结果行，每行按列顺序排列
		RowCount int        `json:"rowCount"` // 返回行数
	}
	SqlToolsQueryResp {
		Data SqlToolsQueryResult `json:"data"` // 查询结果
	}
)

