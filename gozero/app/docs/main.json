{
  "openapi": "3.0.0",
  "info": {
    "title": "GoZero部分的Swagger文档",
    "version": "1.0.0",
    "description": "这是项目的GoZero部分的Swagger文档",
    "x-author": "hongch666"
  },
  "paths": {
    "/search": {
      "get": {
        "description": "根据关键词、用户ID、用户名、发布时间范围等条件搜索文章（支持分页）",
        "tags": [
          "搜索模块"
        ],
        "summary": "搜索文章",
        "operationId": "searchSearchArticlesHandler",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "allowEmptyValue": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "user_id",
            "in": "query",
            "allowEmptyValue": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "username",
            "in": "query",
            "allowEmptyValue": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category_name",
            "in": "query",
            "allowEmptyValue": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sub_category_name",
            "in": "query",
            "allowEmptyValue": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "start_date",
            "in": "query",
            "allowEmptyValue": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "end_date",
            "in": "query",
            "allowEmptyValue": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "allowEmptyValue": true,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "size",
            "in": "query",
            "allowEmptyValue": true,
            "schema": {
              "type": "integer",
              "default": 10
            }
          },
          {
            "name": "mode",
            "in": "query",
            "allowEmptyValue": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "enable_vector",
            "in": "query",
            "allowEmptyValue": true,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "enable_graph",
            "in": "query",
            "allowEmptyValue": true,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "explain",
            "in": "query",
            "allowEmptyValue": true,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "list": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "title",
                          "content",
                          "user_id",
                          "username",
                          "tags",
                          "status",
                          "views",
                          "like_count",
                          "collect_count",
                          "author_follow_count",
                          "category_name",
                          "sub_category_name",
                          "create_at",
                          "update_at",
                          "ai_score",
                          "user_score",
                          "ai_comment_count",
                          "user_comment_count",
                          "es_score",
                          "vector_score",
                          "graph_score",
                          "final_score",
                          "reason",
                          "semantic_reason",
                          "relations",
                          "matched_chunks",
                          "score_details"
                        ],
                        "properties": {
                          "ai_comment_count": {
                            "type": "integer"
                          },
                          "ai_score": {
                            "type": "number"
                          },
                          "author_follow_count": {
                            "type": "integer"
                          },
                          "category_name": {
                            "type": "string"
                          },
                          "collect_count": {
                            "type": "integer"
                          },
                          "content": {
                            "type": "string"
                          },
                          "create_at": {
                            "type": "string"
                          },
                          "es_score": {
                            "type": "number"
                          },
                          "final_score": {
                            "type": "number"
                          },
                          "graph_score": {
                            "type": "number"
                          },
                          "id": {
                            "type": "integer"
                          },
                          "like_count": {
                            "type": "integer"
                          },
                          "matched_chunks": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "required": [
                                "article_id",
                                "title",
                                "chunk_index",
                                "score",
                                "content"
                              ],
                              "properties": {
                                "article_id": {
                                  "type": "integer"
                                },
                                "chunk_index": {
                                  "type": "integer"
                                },
                                "content": {
                                  "type": "string"
                                },
                                "score": {
                                  "type": "number"
                                },
                                "title": {
                                  "type": "string"
                                }
                              }
                            }
                          },
                          "reason": {
                            "type": "string"
                          },
                          "relations": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "required": [
                                "type",
                                "name",
                                "score",
                                "reason"
                              ],
                              "properties": {
                                "name": {
                                  "type": "string"
                                },
                                "reason": {
                                  "type": "string"
                                },
                                "score": {
                                  "type": "number"
                                },
                                "type": {
                                  "type": "string"
                                }
                              }
                            }
                          },
                          "score_details": {
                            "type": "object",
                            "required": [
                              "es_score",
                              "vector_score",
                              "graph_score",
                              "business_score",
                              "recency_score"
                            ],
                            "properties": {
                              "business_score": {
                                "type": "number"
                              },
                              "es_score": {
                                "type": "number"
                              },
                              "graph_score": {
                                "type": "number"
                              },
                              "recency_score": {
                                "type": "number"
                              },
                              "vector_score": {
                                "type": "number"
                              }
                            }
                          },
                          "semantic_reason": {
                            "type": "string"
                          },
                          "status": {
                            "type": "integer"
                          },
                          "sub_category_name": {
                            "type": "string"
                          },
                          "tags": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          },
                          "update_at": {
                            "type": "string"
                          },
                          "user_comment_count": {
                            "type": "integer"
                          },
                          "user_id": {
                            "type": "integer"
                          },
                          "user_score": {
                            "type": "number"
                          },
                          "username": {
                            "type": "string"
                          },
                          "vector_score": {
                            "type": "number"
                          },
                          "views": {
                            "type": "integer"
                          }
                        }
                      }
                    },
                    "total": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/search/history/{user_id}": {
      "get": {
        "description": "获取指定用户最近10条搜索关键词列表",
        "tags": [
          "搜索模块"
        ],
        "summary": "获取用户搜索历史",
        "operationId": "searchGetSearchHistoryHandler",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "keywords": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/sql-tools/query": {
      "post": {
        "description": "执行受限的只读参数化SQL查询，表名白名单控制，强制参数化占位符和LIMIT",
        "tags": [
          "SQL工具模块"
        ],
        "summary": "执行只读参数化SQL查询",
        "operationId": "sqlToolsSqlToolsQueryHandler",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "query"
                ],
                "properties": {
                  "params": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "query": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "columns",
                        "rows",
                        "rowCount"
                      ],
                      "properties": {
                        "columns": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "rowCount": {
                          "type": "integer"
                        },
                        "rows": {
                          "type": "array",
                          "items": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/sql-tools/tables": {
      "get": {
        "description": "获取白名单内MySQL表的结构信息，可选指定表名",
        "tags": [
          "SQL工具模块"
        ],
        "summary": "获取表结构信息",
        "operationId": "sqlToolsSqlToolsGetTablesHandler",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "table": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "table"
                        ],
                        "properties": {
                          "columns": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "required": [
                                "name",
                                "type",
                                "key",
                                "comment"
                              ],
                              "properties": {
                                "comment": {
                                  "type": "string"
                                },
                                "key": {
                                  "type": "string"
                                },
                                "name": {
                                  "type": "string"
                                },
                                "type": {
                                  "type": "string"
                                }
                              }
                            }
                          },
                          "table": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/sse/chat": {
      "get": {
        "description": "建立SSE连接。成功时以 text/event-stream 持续推送数据帧，帧结构见响应模型；参数非法时返回统一 JSON 错误体",
        "tags": [
          "聊天模块"
        ],
        "summary": "SSE消息通知连接",
        "operationId": "chatChatSSEHandler",
        "parameters": [
          {
            "name": "user_id",
            "in": "query",
            "allowEmptyValue": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "连接建立成功，随后持续推送数据帧，每帧对应 ChatSSEMessage",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "object",
                      "required": [
                        "id",
                        "sender_id",
                        "receiver_id",
                        "content",
                        "is_read",
                        "created_at"
                      ],
                      "properties": {
                        "content": {
                          "type": "string"
                        },
                        "created_at": {
                          "type": "string"
                        },
                        "id": {
                          "type": "integer"
                        },
                        "is_read": {
                          "type": "integer"
                        },
                        "receiver_id": {
                          "type": "integer"
                        },
                        "sender_id": {
                          "type": "integer"
                        }
                      }
                    },
                    "type": {
                      "type": "string"
                    },
                    "unread_counts": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "integer"
                      }
                    },
                    "user_id": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "参数非法（如 user_id 非正整数）时返回统一 JSON 错误体",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/task/syncer": {
      "post": {
        "description": "手动触发同步MySQL文章数据到Elasticsearch",
        "tags": [
          "定时任务模块"
        ],
        "summary": "手动触发同步ES任务",
        "operationId": "taskSyncESHandler",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/test/gozero": {
      "get": {
        "description": "验证GoZero服务是否正常运行",
        "tags": [
          "测试模块"
        ],
        "summary": "测试GoZero服务",
        "operationId": "testTestGoZeroHandler",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/user-chat/all-unread-counts": {
      "post": {
        "description": "获取指定用户与所有其他用户的未读消息数统计",
        "tags": [
          "聊天模块"
        ],
        "summary": "获取用户的所有未读消息数",
        "operationId": "chatChatGetAllUnreadCountsHandler",
        "requestBody": {
          "$ref": "#/components/requestBodies/chatChatGetAllUnreadCountsHandlerBody"
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/user-chat/history": {
      "post": {
        "description": "分页获取指定两个用户之间的聊天记录",
        "tags": [
          "聊天模块"
        ],
        "summary": "获取聊天历史",
        "operationId": "chatChatGetHistoryHandler",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "user_id",
                  "other_id"
                ],
                "properties": {
                  "other_id": {
                    "type": "integer"
                  },
                  "page": {
                    "type": "integer"
                  },
                  "size": {
                    "type": "integer"
                  },
                  "user_id": {
                    "type": "integer"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "sender_id",
                          "receiver_id",
                          "content",
                          "is_read",
                          "created_at"
                        ],
                        "properties": {
                          "content": {
                            "type": "string"
                          },
                          "created_at": {
                            "type": "string"
                          },
                          "id": {
                            "type": "integer"
                          },
                          "is_read": {
                            "type": "integer"
                          },
                          "receiver_id": {
                            "type": "integer"
                          },
                          "sender_id": {
                            "type": "integer"
                          }
                        }
                      }
                    },
                    "total": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/user-chat/join": {
      "post": {
        "description": "用户手动加入聊天队列，不需要建立WebSocket连接",
        "tags": [
          "聊天模块"
        ],
        "summary": "手动加入聊天队列",
        "operationId": "chatChatJoinQueueHandler",
        "requestBody": {
          "$ref": "#/components/requestBodies/chatChatGetAllUnreadCountsHandlerBody"
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "user_id": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/user-chat/leave": {
      "post": {
        "description": "用户手动离开聊天队列",
        "tags": [
          "聊天模块"
        ],
        "summary": "手动离开聊天队列",
        "operationId": "chatChatLeaveQueueHandler",
        "requestBody": {
          "$ref": "#/components/requestBodies/chatChatGetAllUnreadCountsHandlerBody"
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "user_id": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/user-chat/queue": {
      "get": {
        "description": "获取当前在队列中的所有用户",
        "tags": [
          "聊天模块"
        ],
        "summary": "获取队列状态",
        "operationId": "chatChatGetQueueStatusHandler",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer"
                    },
                    "online_users": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/user-chat/send": {
      "post": {
        "description": "发送聊天消息，先保存到数据库，再通过WebSocket发送给在线用户",
        "tags": [
          "聊天模块"
        ],
        "summary": "发送聊天消息",
        "operationId": "chatChatSendMessageHandler",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "sender_id",
                  "receiver_id",
                  "content"
                ],
                "properties": {
                  "content": {
                    "type": "string"
                  },
                  "receiver_id": {
                    "type": "integer"
                  },
                  "sender_id": {
                    "type": "integer"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message_id": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/user-chat/unread-count": {
      "post": {
        "description": "获取指定用户与另一个用户间的未读消息数",
        "tags": [
          "聊天模块"
        ],
        "summary": "获取两个用户间的未读消息数",
        "operationId": "chatChatGetUnreadCountHandler",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "user_id",
                  "other_id"
                ],
                "properties": {
                  "other_id": {
                    "type": "integer"
                  },
                  "user_id": {
                    "type": "integer"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "unread_count": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ws/chat": {
      "get": {
        "description": "建立WebSocket连接，自动加入聊天队列。握手成功返回 101 升级协议，之后通过文本帧双向通信，帧结构见响应模型",
        "tags": [
          "聊天模块"
        ],
        "summary": "WebSocket聊天连接",
        "operationId": "chatChatWebsocketHandler",
        "parameters": [
          {
            "name": "user_id",
            "in": "query",
            "allowEmptyValue": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "101": {
            "description": "协议升级成功（Switching Protocols），之后通过 WebSocket 文本帧双向通信，帧结构对应 ChatWsMessage"
          },
          "400": {
            "description": "参数非法（如 user_id 非正整数）时返回统一 JSON 错误体",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
