# Spring 服务配置
SERVER_ADDRESS=0.0.0.0
SERVER_MODE=dev
SERVER_PORT=8081
METRICS_PORT=9101

# 定时任务开关，未配置时默认启用；置为 false 时不注册本地 @Scheduled 任务
TASK_ENABLED=true

# MySQL 配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=demo_spring
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=1
# REDIS_USERNAME=
# REDIS_PASSWORD=

# RabbitMQ 配置
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=your_rabbitmq_username
RABBITMQ_PASSWORD=your_rabbitmq_password
RABBITMQ_VHOST=test

# 日志配置
LOGGING_PATH=../logs/spring
LOG_INCLUDE_TIMESTAMP=true
R2DBC_LOG_LEVEL=DEBUG

# JWT 配置
JWT_SECRET=your_jwt_secret
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000
INTERNAL_TOKEN_SECRET=your_internal_token_secret
INTERNAL_TOKEN_EXPIRATION=60000

# 用户默认密码配置（创建用户未指定密码与管理员重置未指定密码时共用）
USER_DEFAULT_PASSWORD=your_default_password

# Nacos 配置
NACOS_SERVER=127.0.0.1:8848
NACOS_NAMESPACE=public
NACOS_GROUP_NAME=DEFAULT_GROUP

# OpenTelemetry 链路追踪
# OTEL_ENABLED=true
OTEL_SERVICE_NAME=spring
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_SAMPLER=always_on
